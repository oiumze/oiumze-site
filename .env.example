# GitHub OAuth App usado pelo login do Sveltia CMS (/admin).
# Callback URL da OAuth App: https://<domínio>/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Basic Auth do ambiente de homolog (hmg.umze.com.br). Defina só no ambiente da Vercel que serve o hmg;
# sem elas o site fica público e estático. Localmente, exporte no shell antes do `pnpm dev`/`pnpm build`.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

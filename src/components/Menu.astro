---
const links = [
  { href: '/#inicio', label: 'Início' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#meu-som', label: 'Meu Som' },
  { href: '/#galeria', label: 'Galeria' },
  { href: '/#imprensa', label: 'Imprensa' },
];

const linkClass = 'hover:underline underline-offset-4 aria-[current=location]:text-yellow-strong aria-[current=location]:underline';
---

<header class="drawer drawer-end" data-scrollspy>
  <input id="menu-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- borda vermelha de 2px embaixo (box-shadow sem desfoque: não muda os 56px de altura), só depois do Hero (data-past-hero, ver script):
         separa o menu da seção Sobre, ambos pretos -->
    <div id="menu-bar" class="fixed inset-x-0 top-0 z-10 bg-black text-yellow-light px-6 transition-shadow duration-300 data-past-hero:shadow-[0_2px_0_var(--color-red)] lg:px-12">
      <div class="navbar min-h-14 mx-auto max-w-[1200px] px-0">
        <div class="navbar-start w-auto">
          <h1 class="sr-only">Umzé</h1>
          <a href="/#inicio" class="block shrink-0">
            <img
              src="/images/logo/logo.png"
              srcset="/images/logo/logo.png 1x, /images/logo/logo@2x.png 2x, /images/logo/logo@3x.png 3x"
              alt="Ir para o início"
              width="47"
              height="38"
              class="block"
            />
          </a>
        </div>
        <div class="navbar-end flex-1">
          <nav aria-label="Menu principal" class="hidden lg:block">
            <ul class="flex gap-18 whitespace-nowrap font-righteous text-xl uppercase">
              {links.map(({ href, label }) => <li><a href={href} class={linkClass}>{label}</a></li>)}
            </ul>
          </nav>
          <label for="menu-drawer" aria-label="Abrir menu" class="btn btn-ghost lg:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
          </label>
        </div>
      </div>
    </div>
  </div>
  <div class="drawer-side z-20 lg:hidden">
    <label for="menu-drawer" aria-label="Fechar menu" class="drawer-overlay"></label>
    <nav aria-label="Menu principal" class="min-h-full w-64 bg-black text-yellow-light p-6">
      <label for="menu-drawer" aria-label="Fechar menu" class="btn btn-ghost btn-square mb-6 ml-auto flex">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /> </svg>
      </label>
      <ul class="flex flex-col gap-6 font-righteous text-xl uppercase">
        {links.map(({ href, label }) => <li><a href={href} class={linkClass}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-scrollspy]');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('a[href*="#"]') ?? [])].filter((a) => a.hash.length > 1);
  const sections = [...new Set(links.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let currentId: string | null = null;

  const setActive = (id: string | null) => {
    currentId = id;
    for (const a of links) {
      if (a.hash === `#${id}`) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };

  // Seção ativa = a que cruza a linha do meio da tela
  const observer = new IntersectionObserver(
    (entries) => {
      const entering = entries.find((e) => e.isIntersecting);
      if (entering) setActive(entering.target.id);
      else if (entries.some((e) => e.target.id === currentId)) setActive(null);
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));

  // Borda do menu só depois que o Hero (#inicio) sai de baixo dele. rootMargin tira os 56px do menu + 4px de folga:
  // ao clicar em "Sobre" a rolagem para com o Hero encostado exatamente no menu, e borda encostada conta como
  // interseção para o IntersectionObserver.
  const bar = document.getElementById('menu-bar');
  const hero = document.getElementById('inicio');
  if (bar && hero) {
    new IntersectionObserver(([e]) => bar.toggleAttribute('data-past-hero', !e.isIntersecting), {
      rootMargin: '-60px 0px 0px 0px',
    }).observe(hero);
  }

  // Fecha a sidebar mobile ao clicar num link
  const drawerToggle = document.querySelector<HTMLInputElement>('#menu-drawer');
  nav?.querySelector('.drawer-side')?.addEventListener('click', (e) => {
    if (drawerToggle && (e.target as HTMLElement).closest('a')) drawerToggle.checked = false;
  });
</script>

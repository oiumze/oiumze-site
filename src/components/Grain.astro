---
// Grão de filme antigo sobre o site inteiro: ruído SVG (feTurbulence) em tile, misturado
// com overlay (modula a luminância do que está embaixo, como grão de foto, sem véu claro)
// e deslocado para posições aleatórias a cada quadro, sem loop, para parecer natural.
// Com mouse, um círculo em volta do cursor mostra o site sem grão (mask-image).
// Não captura cliques e fica parado com prefers-reduced-motion.
// Parâmetros em src/lib/grain.ts.
import { grainDefaults, grainStyle } from '../lib/grain';
---

<!-- Container parado do tamanho da tela: leva blend, opacidade e a máscara do cursor
     (mix-blend-mode precisa estar no elemento que cria o contexto de empilhamento).
     O filho com a textura só se move por transform: vira uma camada da GPU rasterizada
     uma vez, sem repintar a tela a cada quadro. -->
<div
	id="grain"
	aria-hidden="true"
	data-fps={grainDefaults.fps}
	data-fps-touch={grainDefaults.fpsTouch}
	class="grain pointer-events-none fixed inset-0 z-[9999] overflow-hidden"
	style={grainStyle(grainDefaults)}
>
	<div class="grain-noise"></div>
</div>

<style>
	.grain {
		/* fora da tela até o mouse entrar, então sem buraco no touch */
		--mx: -9999px;
		--my: -9999px;
		--hole: radial-gradient(
			circle at var(--mx) var(--my),
			transparent calc(var(--grain-hole) * (1 - var(--grain-feather))),
			black var(--grain-hole)
		);
		-webkit-mask-image: var(--hole);
		mask-image: var(--hole);
	}

	/* 1 tile a mais para cada lado: qualquer salto de 0 a 1 tile ainda cobre a tela */
	.grain-noise {
		position: absolute;
		inset: calc(-1 * var(--grain-tile));
		background-image: var(--grain-noise);
		will-change: transform;
	}
</style>

<script>
	import { grainDefaults, grainMaskUrl, grainNoiseUrl } from '../lib/grain';

	const grain = document.getElementById('grain');
	const noise = grain?.querySelector<HTMLElement>('.grain-noise');
	const reduced = matchMedia('(prefers-reduced-motion: reduce)');

	// O SVG é rasterizado na resolução física: em telas 2x/3x (celular) o grão sairia 2–3× menor e
	// sumiria. Dividir a frequência por √devicePixelRatio aumenta o grão só o bastante para aparecer:
	// dividir pelo dpr inteiro deixa o grão do tamanho da tela 1x, grosso e com cara de baixa resolução.
	const dpr = Math.max(1, devicePixelRatio);
	const config = { ...grainDefaults, baseFrequency: grainDefaults.baseFrequency / Math.sqrt(dpr) };
	if (grain && dpr > 1) grain.style.setProperty('--grain-noise', grainNoiseUrl(config));

	// Elementos com [data-grain-mask] (ex.: contornos amarelos do Hero): o overlay do grão quase não
	// altera cores saturadas, então o grão entra também como máscara de alpha no próprio elemento,
	// saltando junto com a textura. O valor do atributo é o alpha mínimo (padrão 0.5).
	const masked = [...document.querySelectorAll<HTMLElement | SVGElement>('[data-grain-mask]')];
	// só move a máscara de quem está na tela: mexer em mask-position redesenha o elemento
	const maskVisible = new Set<Element>();
	const maskObserver = new IntersectionObserver((entries) => {
		for (const e of entries) e.isIntersecting ? maskVisible.add(e.target) : maskVisible.delete(e.target);
	});
	for (const el of masked) {
		maskObserver.observe(el);
		const url = grainMaskUrl(config, Number(el.dataset.grainMask) || 0.5);
		for (const prefix of ['', '-webkit-']) {
			el.style.setProperty(`${prefix}mask-image`, url);
			el.style.setProperty(`${prefix}mask-size`, `${config.tile}px`);
		}
	}

	// Saltos aleatórios: a cada quadro a textura vai para um offset qualquer dentro de
	// um tile, então o padrão nunca se repete.
	// Telas de toque (celular) saltam menos por segundo: o grão cobre a página com mix-blend-mode, e cada
	// salto obriga a GPU a recompor a tela inteira.
	const touch = matchMedia('(pointer: coarse)');
	let last = 0;
	function frame(now: number) {
		requestAnimationFrame(frame);
		const fps = Number(touch.matches ? grain?.dataset.fpsTouch : grain?.dataset.fps);
		// -2ms de folga: sem ela, o jitter do rAF (16.6 vs 16.7ms) derruba 60fps para 30
		if (!grain || !noise || reduced.matches || !fps || now - last < 1000 / fps - 2) return;
		last = now;
		const tile = parseFloat(grain.style.getPropertyValue('--grain-tile')) || 0;
		const x = Math.round(Math.random() * tile);
		const y = Math.round(Math.random() * tile);
		noise.style.transform = `translate3d(${x}px, ${y}px, 0)`;
		for (const el of maskVisible as Set<HTMLElement | SVGElement>) {
			el.style.setProperty('mask-position', `${x}px ${y}px`);
			el.style.setProperty('-webkit-mask-position', `${x}px ${y}px`);
		}
	}
	requestAnimationFrame(frame);

	// Círculo sem grão seguindo o mouse (ignora toque/caneta).
	addEventListener('pointermove', (e) => {
		if (!grain || e.pointerType !== 'mouse') return;
		grain.style.setProperty('--mx', `${e.clientX}px`);
		grain.style.setProperty('--my', `${e.clientY}px`);
	});
	document.documentElement.addEventListener('mouseleave', () => {
		grain?.style.setProperty('--mx', '-9999px');
		grain?.style.setProperty('--my', '-9999px');
	});
</script>

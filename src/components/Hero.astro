---
interface Props {
	id?: string;
	title?: string;
}

const { id = 'inicio', title = 'Início' } = Astro.props;
---

<!-- título só via aria-label -->
<section id={id} aria-label={title} class="relative isolate min-h-section scroll-mt-14 overflow-hidden">
	<!-- imagem de fundo: <img> com srcset (1x/2x) em vez de background-image para o navegador escolher a densidade e priorizar o carregamento (LCP) -->
	<img
		src="/images/hero-01.png"
		srcset="/images/hero-01.png 1x, /images/hero-01@2x.png 2x"
		width="1440"
		height="968"
		alt=""
		fetchpriority="high"
		decoding="async"
		class="absolute inset-0 -z-10 size-full object-cover"
	/>
</section>
